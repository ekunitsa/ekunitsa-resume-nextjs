{
    "name": "ekunitsa-resume",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint:scss": "stylelint \"./src/**/*.scss\"",
        "lint:biome": "biome check .",
        "lint:tsc": "npx tsc --noEmit",
        "lint": "concurrently \"npm run lint:biome\" \"npm run lint:scss\" \"npm run lint:tsc\"",
        "prisma:validate": "prisma validate",
        "prisma:generate": "prisma generate",
        "pre-commit": "npm run lint",
        "prepare": "husky"
    },
    "dependencies": {
        "@next-auth/prisma-adapter": "^1.0.7",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@react-pdf/renderer": "^4.5.1",
        "@tanstack/react-table": "^8.21.3",
        "bcrypt": "^6.0.0",
        "classnames": "^2.5.1",
        "dayjs": "^1.11.21",
        "dotenv": "^17.4.2",
        "isomorphic-dompurify": "^2.36.0",
        "next": "^16.3.0",
        "next-auth": "^4.24.15",
        "next-intl": "^4.13.5",
        "pg": "^8.22.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.84.0",
        "react-icons": "^5.7.0",
        "scss-reset": "^1.4.6",
        "sharp": "^0.35.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@svgr/webpack": "^8.1.0",
        "@types/bcrypt": "^6.0.0",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.4",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "concurrently": "^10.0.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prisma": "^7.9.1",
        "sass": "^1.102.0",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-scss": "^7.2.0",
        "typescript": "^6"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "biome check --no-errors-on-unmatched"
        ],
        "*.{css,scss}": [
            "stylelint --allow-empty-input"
        ]
    }
}
