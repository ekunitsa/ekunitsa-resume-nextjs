# Copy the host, port and SSL options from .env, but use only the dedicated test user and database.
DATABASE_URL=postgresql://LOGIN:PASSWORD@SERVER:PORT/DATABASE_NAME

NEXTAUTH_URL=http://127.0.0.1:3100
NEXTAUTH_SECRET=CHANGE_ME_TO_A_TEST_ONLY_SECRET

SITE_URL=http://127.0.0.1:3100
SITE_NAME=E2E CV

E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=CHANGE_ME_TO_A_TEST_ONLY_PASSWORD
E2E_ADMIN_NAME=E2E Admin
